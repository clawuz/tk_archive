rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAllowedDomain() {
      return request.auth.token.email.matches('.*@tribalistanbul\\.com$')
          || request.auth.token.email.matches('.*@twist\\.ddb\\.com$')
          || request.auth.token.email.matches('.*@thy\\.com$');
    }

    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isBudgetRole() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'super_admin' || role == 'finance' || role == 'admin';
    }

    // Users collection. Read: your own profile, or any if you're staff.
    // Create/delete: staff only — new accounts come from requestAccess
    // (Admin SDK, bypasses these rules) rather than a client-side create.
    // Update: you can edit your own profile, but not your own `role` — that
    // field is the one thing self-write must never touch, or any signed-in
    // user could grant themselves admin. Staff can change anyone's role.
    match /users/{userId} {
      allow read: if isAuthenticated() && isAllowedDomain() && (request.auth.uid == userId || hasRole('admin') || hasRole('super_admin'));
      allow create, delete: if isAuthenticated() && isAllowedDomain() && (hasRole('admin') || hasRole('super_admin'));
      allow update: if isAuthenticated() && isAllowedDomain() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        hasRole('admin') || hasRole('super_admin')
      );
    }

    // Agency state — budget field restricted
    match /agency/{docId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if isAuthenticated() && isAllowedDomain() && isBudgetRole();
    }

    // Education — read by all Tribal/Twist users, write by admin only
    match /education/{docId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if isAuthenticated() && isAllowedDomain() && (hasRole('admin') || hasRole('super_admin'));
    }

    // Awards archive — read by all Tribal/Twist users, write by admin only
    match /awards/{docId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if isAuthenticated() && isAllowedDomain() && (hasRole('admin') || hasRole('super_admin'));
    }

    // Archive inventory scan jobs (Task 1 schema, /scans/{scanId}).
    //
    // Read: owner only OR Cloud Functions service account. `resource.data.userId`
    // is the field JobManager writes at creation, and the same field
    // scanResults/getScanStatus check before returning anything. No public read.
    // Cloud Functions run as archive-scanner service account; they need
    // direct Firestore access since they verify ownership in code.
    //
    // Write: denied to every client. Scan documents are only ever written by
    // the Cloud Functions and by the Cloud Run job, all of which use the
    // Admin SDK and bypass these rules entirely. A client-writable /scans
    // would let a user forge a `completed` status, rewrite `results` to point
    // at another job's files, or reassign `userId` to steal a scan.
    match /scans/{scanId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if false;
    }

    // Scan logs (COLLECTIONS.SCAN_LOGS) — backend-only, same reasoning.
    match /scan_logs/{logId} {
      allow read, write: if false;
    }

    // ========================================================================
    // TK Archive DAM Collections
    // ========================================================================

    // Files collection — DAM file metadata. Read: any signed-in team member
    // (the whole point of the archive). Write: admin/super_admin only — the
    // scanner and Cloud Functions write via the Admin SDK regardless, which
    // bypasses these rules entirely, so this only ever gates client writes
    // (tag edits, rights edits) from the app itself.
    match /files/{fileId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if isAuthenticated() && isAllowedDomain() && (hasRole('admin') || hasRole('super_admin'));
      // Any signed-in team member may ask for a video to be uploaded for
      // playback ("Oynatmak için yükle") — exactly this one field, only to
      // true. enrich.cjs (Admin SDK) does the work and clears it.
      allow update: if isAuthenticated() && isAllowedDomain()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upload_requested'])
        && request.resource.data.upload_requested == true;
    }

    // Changes collection — incremental file changes, written by the scanner
    // via the Admin SDK only; no legitimate client write path.
    match /changes/{changeId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if false;
    }

    // AI worker heartbeat — written by tk-ai-engine/sprint3/ai_worker.py (Admin
    // SDK, bypasses rules). The file panel reads it to warn when the Mac
    // worker is offline while a "Otomatik Etiketle" request is waiting.
    match /ai_worker_status/{docId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if false;
    }

    // Tags collection — managed tags vocabulary. Read: any signed-in team
    // member (tag filter/autocomplete needs this). Write: admin/super_admin
    // only, matching the UI's own canEdit gate on tag add/remove.
    match /tags/{tagId} {
      allow read: if isAuthenticated() && isAllowedDomain();
      allow write: if isAuthenticated() && isAllowedDomain() && (hasRole('admin') || hasRole('super_admin'));
    }
  }
}
